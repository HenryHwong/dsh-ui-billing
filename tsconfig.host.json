{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@deepseek-ai/dsh-billing/client": ["./types/dsh-billing/client.d.ts"]
    }
  },
  "include": [
    "src/index.ts",
    "src/balance.ts",
    "src/invariant.ts",
    "src/projection.ts",
    "tests/apply.host.spec.ts",
    "tests/balance.host.spec.ts",
    "tests/projection.spec.ts"
  ]
}
